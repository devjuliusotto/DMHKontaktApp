{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding",
        "height": 780,
        "minHeight": 600,
        "minWidth": 760,
        "title": "DMH Backup",
        "width": 1180
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build:outlook-helper && npm run build",
    "beforeDevCommand": "npm run prepare:outlook-helper && npm run dev -- --port 4000",
    "devUrl": "http://localhost:4000",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "longDescription": "DMH Backup sichert Kontakte, Gruppen und Termine für die bevorstehende Migration.",
    "publisher": "Diakonissenmutterhaus Aidlingen e.V.",
    "resources": [
      "resources/**/*"
    ],
    "shortDescription": "Lokale Sicherung für die DMH-Migration",
    "targets": [
      "msi",
      "nsis"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/sign-windows-artifact.ps1",
          "-ArtifactPath",
          "%1"
        ]
      }
    }
  },
  "identifier": "de.dmh.agendakontakte",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Diakonissenmutterhaus/DMHKontaktApp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNUFCRkU2MTM3ODc2MTAKUldRUWRuZ1Q1cjlhdk1MaUowYzBtRTFXeXJpYURCMnhCa1pqa3FaNk55ZGdnbEFjbTJFdkh5OVAK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "productName": "DMH Backup",
  "version": "0.1.1"
}
