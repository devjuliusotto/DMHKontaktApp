{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding",
        "height": 780,
        "minHeight": 600,
        "minWidth": 760,
        "title": "DMH Backup [ADMIN TEST]",
        "width": 1180
      }
    ]
  },
  "bundle": {
    "longDescription": "Isolierter Testkanal für DMH Backup.",
    "shortDescription": "Admin-Testversion der lokalen Kontakt- und Kalenderverwaltung",
    "targets": [
      "nsis"
    ]
  },
  "identifier": "de.dmh.agendakontakte.admin-test",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/devjuliusotto/DMHKontaktApp/releases/download/admin-test/latest.json"
      ]
    }
  },
  "productName": "DMH Backup Admin Test"
}
